# Contact form (GoDaddy / Titan SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Visitor counter — free Redis database from https://console.upstash.com
# (Create database → REST API section). Used only by the /api/visitors function,
# never shipped to the browser — do NOT prefix with VITE_. Without these the footer
# badge is hidden instead of showing a fake number.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
